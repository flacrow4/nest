@host = http://localhost:3000

### C - Create (Создать пользователя)
# user_id и id не передаем, база данных создаст их сама.
POST {{host}}/users
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "securepassword123",
  "firstname": "Антон",
  "lastname": "Антонов",
  "policy": "220088996677",
  "age": 35
}

### L - List (Получить всех)
GET {{host}}/users

### R - Read (Получить одного)
# Замените 1 на реальный ID, который вернется после создания
GET {{host}}/users/1

### U - Update (Обновить профиль)
# Замените 2 на реальный ID
PATCH {{host}}/users/2
Content-Type: application/json

{
  "firstname": "Петр",
  "age": 36
}

### D - Delete (Удалить)
# Замените 2 на реальный ID
DELETE {{host}}/users/2