@host = http://localhost:3000

### C - Create (Создать пользователя)
# id не передаем, база данных создаст его сама.
POST {{host}}/users
Content-Type: application/json

{
  "firstname": "Дима",
  "lastname": "Димов",
  "policy": "224388996677",
  "age": 34
}

### L - List (Получить всех)
GET {{host}}/users

### R - Read (Получить одного)
# Замените 1 на реальный ID, который вернется после создания
GET {{host}}/users/1

### U - Update (Обновить профиль)
# Замените 2 на реальный ID
PATCH {{host}}/users/2
Content-Type: application/json

{
  "firstname": "Петр",
  "age": 36
}

### D - Delete (Удалить)
# Замените 2 на реальный ID
DELETE {{host}}/users/2